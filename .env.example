APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
JWT_SECRET=<JWT_SECRET>
JWT_AUDIENCE=applyengine-api
JWT_ISSUER=applyengine
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=10080
